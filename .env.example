# Barakah needs no API keys, and the build runs without this file.
#
# The Secrets Gradle Plugin is pointed at .env / .env.example in app/build.gradle.kts because the
# project started from an AI Studio template. Release signing does not come from here: the CI
# workflow writes app/keystore.jks from the BARAKAH_KEYSTORE_BASE64 secret and passes
# BARAKAH_KEYSTORE_PASSWORD, BARAKAH_KEY_ALIAS and BARAKAH_KEY_PASSWORD as environment variables.
