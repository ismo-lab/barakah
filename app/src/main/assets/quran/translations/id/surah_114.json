{"verses":[{"index":1,"text":"Katakanlah, \"Aku berlindung kepada Tuhannya manusia"},{"index":2,"text":"Raja manusia"},{"index":3,"text":"sembahan manusia"},{"index":4,"text":"dari kejahatan (bisikan) setan yang bersembunyi"},{"index":5,"text":"yang membisikkan (kejahatan) ke dalam dada manusia"},{"index":6,"text":"dari (golongan) jin dan manusia"}]}