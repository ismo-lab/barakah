{"verses":[{"index":1,"text":"Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)"},{"index":2,"text":"Одни лица в тот день будут унижены"},{"index":3,"text":"изнурены и утомлены"},{"index":4,"text":"Они войдут в Огонь жаркий"},{"index":5,"text":"Их будут поить из источника кипящего"},{"index":6,"text":"и кормить только ядовитыми колючками"},{"index":7,"text":"от которых не поправляются и которые не утоляют голода"},{"index":8,"text":"Другие же лица в тот день будут радостны"},{"index":9,"text":"Они будут довольны своими стараниями"},{"index":10,"text":"в Вышних садах"},{"index":11,"text":"Они не услышат там словоблудия"},{"index":12,"text":"Там есть источник текущий"},{"index":13,"text":"Там воздвигнуты ложа"},{"index":14,"text":"расставлены чаши"},{"index":15,"text":"разложены подушки"},{"index":16,"text":"и разостланы ковры"},{"index":17,"text":"Неужели они не видят, как созданы верблюды"},{"index":18,"text":"как вознесено небо"},{"index":19,"text":"как водружены горы"},{"index":20,"text":"как распростерта земля"},{"index":21,"text":"Наставляй же, ведь ты - наставник"},{"index":22,"text":"и ты не властен над ними"},{"index":23,"text":"А тех, кто отвернется и не уверует"},{"index":24,"text":"Аллах подвергнет величайшим мучениям"},{"index":25,"text":"К Нам они вернутся"},{"index":26,"text":"и затем Мы потребуем у них отчета"}]}