{"verses":[{"index":1,"text":"Güneş katlanıp dürüldüğünde"},{"index":2,"text":"Yıldızlar (kararıp) döküldüğünde"},{"index":3,"text":"Dağlar (sallanıp) yürütüldüğünde"},{"index":4,"text":"Gebe develer salıverildiğinde"},{"index":5,"text":"Vahşî hayvanlar toplanıp bir araya getirildiğinde"},{"index":6,"text":"Denizler kaynatıldığında"},{"index":7,"text":"Ruhlar (bedenlerle) birleştirildiğinde"},{"index":8,"text":"Diri diri toprağa gömülen kıza, sorulduğunda"},{"index":9,"text":"hangi günah sebebiyle öldürüldüğü"},{"index":10,"text":"(Amellerin yazılı olduğu) defterler açıldığında"},{"index":11,"text":"Gökyüzü sıyrılıp alındığında"},{"index":12,"text":"cehennem tutuşturulduğunda"},{"index":13,"text":"ve cennet yaklaştırıldığında"},{"index":14,"text":"Kişi neler getirdiğini öğrenmiş olacaktır"},{"index":15,"text":"Hayır! (Gündüz) sinen"},{"index":16,"text":"akıp giden, etrafı aydınlatan yıldızlara andolsun"},{"index":17,"text":"Kararmaya yüz tuttuğunda geceye andolsun"},{"index":18,"text":"Ağarmaya başladığında sabaha andolsun ki"},{"index":19,"text":"itibarlı bir elçinin (Cebrail'in) getirdiği sözdür"},{"index":20,"text":"O (Kur'an), şüphesiz değerli, güçlü ve Arş'ın sahibi (Allah'ın) katında"},{"index":21,"text":"O orada sayılan, güvenilen (elçi)'dir"},{"index":22,"text":"Arkadaşınız (Muhammed) de mecnun değildir"},{"index":23,"text":"Andolsun ki, onu (Cebrail'i) apaçık ufukta görmüştür"},{"index":24,"text":"O, gaybın bilgilerini (sizden) esirgemez"},{"index":25,"text":"O lanetlenmiş şeytanın sözü de değildir"},{"index":26,"text":"Hal böyle iken nereye gidiyorsunuz"},{"index":27,"text":"O, herkes için, bir öğüttür"},{"index":28,"text":"Sizden doğru yolda gitmek isteyenler için"},{"index":29,"text":"Âlemlerin Rabbi Allah dilemedikçe siz dileyemezsiniz"}]}