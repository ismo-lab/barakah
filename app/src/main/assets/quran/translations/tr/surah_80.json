{"verses":[{"index":1,"text":"(Peygamber), ötürü yüzünü ekşitti ve geri döndü"},{"index":2,"text":"âmânın kendisine gelmesinden"},{"index":3,"text":"(Rasûlüm! Onun halini) sana kim bildirdi! Belki o temizlenecek"},{"index":4,"text":"yahut öğüt alacak da o öğüt ona fayda verecek"},{"index":5,"text":"Kendini (sana) muhtaç görmeyene gelince"},{"index":6,"text":"sen ona yöneliyorsun"},{"index":7,"text":"Oysa ki onun temizlenip arınmasından sen sorumlu değilsin"},{"index":8,"text":"Fakat koşarak ve sana gelenle de"},{"index":9,"text":"(Allah'tan) korkarak"},{"index":10,"text":"ilgilenmiyorsun"},{"index":11,"text":"Hayır, şüphesiz bunlar (ayetler ), bir öğüttür"},{"index":12,"text":"Dileyen ondan ( Kur'an'dan ) öğüt alır"},{"index":13,"text":"Tertemiz kılınmış mukaddes sahifelerde (yazılı)"},{"index":14,"text":"yüce makamlara kaldırılmış"},{"index":15,"text":"katiplerin elleriyle ( yazılıp)"},{"index":16,"text":"değerli ve itaatkar meleklerin"},{"index":17,"text":"Kahrolası insan! Ne inkârcıdır"},{"index":18,"text":"Allah onu neden yarattı"},{"index":19,"text":"Bir nutfeden (spermadan) yarattı da ona şekil verdi"},{"index":20,"text":"Sonra ona yolu kolaylaştırdı"},{"index":21,"text":"Sonra onun canını aldı ve kabre soktu"},{"index":22,"text":"Sonra dilediği bir vakitte onu yeniden diriltir"},{"index":23,"text":"Hayır! (İnsan) Allah'ın emrettiğini yapmadı"},{"index":24,"text":"İnsan, yediğine bir baksın"},{"index":25,"text":"Şöyle ki: Yağmurlar yağdırdık"},{"index":26,"text":"Sonra toprağı göz göz yardık da"},{"index":27,"text":"oradan ekinler bitirdik"},{"index":28,"text":"Üzüm bağları, sebzeler"},{"index":29,"text":"zeytin ve hurma ağaçları"},{"index":30,"text":"iri ve sık ağaçlı bahçeler"},{"index":31,"text":"meyveler ve çayırlar"},{"index":32,"text":"(Bütün bunlar) sizi ve hayvanlarınızı yararlandırmak içindir"},{"index":33,"text":"Kulakları sağır eden o ses geldiğinde"},{"index":34,"text":"İşte o gün kişi kardeşinden kaçar"},{"index":35,"text":"Annesinden, babasından"},{"index":36,"text":"eşinden ve çocuklarından"},{"index":37,"text":"O gün, herkesin kendine yetip artacak bir derdi vardır"},{"index":38,"text":"O gün bir takım yüzler parlak"},{"index":39,"text":"güleç ve sevinçlidir"},{"index":40,"text":"Yine o gün birtakım yüzleri de keder bürümüş"},{"index":41,"text":"hüzünden kapkara kesilmiştir"},{"index":42,"text":"İşte bunlar kâfirlerdir, günahkârlardır"}]}