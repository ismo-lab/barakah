{"verses":[{"index":1,"text":"De ki: İnsanların ilâhına sığınırım"},{"index":2,"text":"İnsanların Melikine (mutlak sahip ve hakimine)"},{"index":3,"text":"insanların Rabbine sığınırım"},{"index":4,"text":"(insan Allah'ı andığında) pusuya çekilen şeytanının şerrinden"},{"index":5,"text":"insanların kalplerine vesvese sokan"},{"index":6,"text":"cin ve insanlardan"}]}