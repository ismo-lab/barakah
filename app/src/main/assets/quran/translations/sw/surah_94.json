{"verses":[{"index":1,"text":"Hatukukunjulia kifua chako"},{"index":2,"text":"Na tukakuondolea mzigo wako"},{"index":3,"text":"Ulio vunja mgongo wako"},{"index":4,"text":"Na tukakunyanyulia utajo wako"},{"index":5,"text":"Basi kwa hakika pamoja na uzito upo wepesi"},{"index":6,"text":"Hakika pamoja na uzito upo wepesi"},{"index":7,"text":"Na ukipata faragha, fanya juhudi"},{"index":8,"text":"Na Mola wako Mlezi ndio mshughulikie"}]}