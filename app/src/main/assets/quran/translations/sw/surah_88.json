{"verses":[{"index":1,"text":"Je! Imekufikia khabari ya msiba wa kufudikiza"},{"index":2,"text":"Siku hiyo nyuso zitainama"},{"index":3,"text":"Zikifanya kazi, nazo taabani"},{"index":4,"text":"Ziingie katika Moto unao waka"},{"index":5,"text":"Zikinyweshwa kutoka chemchem inayo chemka"},{"index":6,"text":"Hawatakuwa na chakula isipo kuwa kichungu chenye miba"},{"index":7,"text":"Hakinenepeshi wala hakiondoi njaa"},{"index":8,"text":"Siku hiyo nyuso nyengine zitakuwa kunjufu"},{"index":9,"text":"Zitakuwa radhi kwa juhudi yao"},{"index":10,"text":"Katika Bustani ya juu"},{"index":11,"text":"Hawatasikia humo upuuzi"},{"index":12,"text":"Humo imo chemchem inayo miminika"},{"index":13,"text":"Humo vimo viti vilivyo nyanyuliwa"},{"index":14,"text":"Na bilauri zilizo pangwa"},{"index":15,"text":"Na matakia safu safu"},{"index":16,"text":"Na mazulia yaliyo tandikwa"},{"index":17,"text":"Je! Hawamtazami ngamia jinsi alivyo umbwa"},{"index":18,"text":"Na mbingu jinsi ilivyo inuliwa"},{"index":19,"text":"Na milima jinsi ilivyo thibitishwa"},{"index":20,"text":"Na ardhi jinsi ilivyo tandazwa"},{"index":21,"text":"Basi kumbusha! Hakika wewe ni Mkumbushaji"},{"index":22,"text":"Wewe si mwenye kuwatawalia"},{"index":23,"text":"Lakini anaye rudi nyuma na kukataa"},{"index":24,"text":"Basi Mwenyezi Mungu atamuadhibu kwa adhabu iliyo kubwa kabisa"},{"index":25,"text":"Hakika ni kwetu Sisi ndio marejeo yao"},{"index":26,"text":"Kisha hakika ni juu yetu Sisi hisabu yao"}]}