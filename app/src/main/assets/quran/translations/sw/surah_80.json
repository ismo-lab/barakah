{"verses":[{"index":1,"text":"Alikunja kipaji na akageuka"},{"index":2,"text":"Kwa sababu alimjia kipofu"},{"index":3,"text":"Na nini kitakujuulisha pengine yeye atatakasika"},{"index":4,"text":"Au atawaidhika, na mawaidha yamfae"},{"index":5,"text":"Ama ajionaye hana haja"},{"index":6,"text":"Wewe ndio unamshughulikia"},{"index":7,"text":"Na si juu yako kama hakutakasika"},{"index":8,"text":"Ama anaye kujia kwa juhudi"},{"index":9,"text":"Naye anaogopa"},{"index":10,"text":"Ndio wewe unampuuza"},{"index":11,"text":"Sivyo hivyo! Huku ni kukumbushana"},{"index":12,"text":"Basi anaye penda akumbuke"},{"index":13,"text":"Yamo katika kurasa zilizo hishimiwa"},{"index":14,"text":"Zilizo inuliwa, zilizo takaswa"},{"index":15,"text":"Zimo mikononi mwa Malaika waandishi"},{"index":16,"text":"Watukufu, wema"},{"index":17,"text":"Ameangamia mwanaadamu! Nini kinacho mkufurisha"},{"index":18,"text":"Kwa kitu gani amemuumba"},{"index":19,"text":"Kwa tone la manii, akamuumba na akamkadiria"},{"index":20,"text":"Kisha akamsahilishia njia"},{"index":21,"text":"Kisha akamfisha, akamtia kaburini"},{"index":22,"text":"Kisha apendapo atamfufua"},{"index":23,"text":"La! Hajamaliza aliyo muamuru"},{"index":24,"text":"Hebu mtu na atazame chakula chake"},{"index":25,"text":"Hakika Sisi tumemimina maji kwa nguvu"},{"index":26,"text":"Tena tukaipasua pasua ardhi kwa nguvu"},{"index":27,"text":"Kisha tukaotesha humo nafaka"},{"index":28,"text":"Na zabibu, na mimea ya majani"},{"index":29,"text":"Na mizaituni, na mitende"},{"index":30,"text":"Na bustani zenye miti iliyo songana baraabara"},{"index":31,"text":"Na matunda, na malisho ya wanyama"},{"index":32,"text":"Kwa manufaa yenu na mifugo yenu"},{"index":33,"text":"Basi utakapo kuja ukelele"},{"index":34,"text":"Siku ambayo mtu atamkimbia nduguye"},{"index":35,"text":"Na mamaye na babaye"},{"index":36,"text":"Na mkewe na wanawe"},{"index":37,"text":"Kila mtu miongoni mwao siku hiyo atakuwa na lake la kumtosha"},{"index":38,"text":"Siku hiyo ziko nyuso zitazo nawiri"},{"index":39,"text":"Zitacheka, zitachangamka"},{"index":40,"text":"Na nyuso siku hiyo zitakuwa na mavumbi"},{"index":41,"text":"Giza totoro litazifunika"},{"index":42,"text":"Hao ndio makafiri watenda maovu"}]}