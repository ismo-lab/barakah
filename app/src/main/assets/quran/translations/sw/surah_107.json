{"verses":[{"index":1,"text":"Je! Umemwona anaye kadhibisha Malipo"},{"index":2,"text":"Huyo ndiye anaye msukuma yatima"},{"index":3,"text":"Wala hahimizi kumlisha masikini"},{"index":4,"text":"Basi, ole wao wanao sali"},{"index":5,"text":"Ambao wanapuuza Sala zao"},{"index":6,"text":"Ambao wanajionyesha"},{"index":7,"text":"Nao huku wanazuia msaada"}]}