<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_preview_bg"
    android:gravity="center">

    <!-- Location Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_location_sample"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/widget_preview_text_title"
        android:layout_marginBottom="12dp" />

    <!-- 4 Nawafil Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4">

        <!-- Duha -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_duha"
                android:textSize="11sp"
                android:textColor="@color/widget_preview_text_secondary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="06:15"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_preview_text_primary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Qiyam -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_qiyam"
                android:textSize="11sp"
                android:textColor="@color/widget_preview_text_secondary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23:30"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_preview_text_primary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Tahajjud -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_tahajjud"
                android:textSize="11sp"
                android:textColor="@color/widget_preview_text_secondary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:30"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_preview_text_primary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Witr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_witr"
                android:textSize="11sp"
                android:textColor="@color/widget_preview_text_secondary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21:20"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_preview_text_primary"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
