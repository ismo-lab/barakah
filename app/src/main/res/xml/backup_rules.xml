<?xml version="1.0" encoding="utf-8"?><!--
   Barakah keeps its data on the device. Android backup would copy the Room database,
   preferences and files off-device, so every supported domain is excluded. The manifest also
   sets allowBackup=false; these rules cover Android 11 and older, where that flag is the only
   control.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
