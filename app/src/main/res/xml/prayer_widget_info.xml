<?xml version="1.0" encoding="utf-8"?>
<!-- targetCellWidth, targetCellHeight and previewLayout only exist on API 31 and above. Older
     versions ignore them, which is the intent here, so lint's UnusedAttribute is expected. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="180dp"
    android:minHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:description="@string/widget_prayer_desc"
    android:previewLayout="@layout/widget_preview_prayer"
    tools:ignore="UnusedAttribute" />
